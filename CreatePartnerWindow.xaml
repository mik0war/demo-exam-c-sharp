<Window x:Class="demo_exam.CreatePartnerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Создание партнёра" 
        Height="600" 
        Width="450"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- Основная форма с ScrollViewer -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Наименование партнёра -->
                <Label Content="Наименование партнёра*"/>
                <TextBox x:Name="NameTextBox" Margin="0,0,0,10"/>

                <!-- Тип партнёра -->
                <Label Content="Тип*"/>
                <ComboBox x:Name="TypeComboBox" Margin="0,0,0,10"/>

                <!-- ФИО директора -->
                <Label Content="Фамилия директора*"/>
                <TextBox x:Name="LastNameTextBox" Margin="0,0,0,10"/>

                <Label Content="Имя директора*"/>
                <TextBox x:Name="FirstNameTextBox" Margin="0,0,0,10"/>

                <Label Content="Отчество директора"/>
                <TextBox x:Name="SurnameTextBox" Margin="0,0,0,10"/>

                <!-- Контактная информация -->
                <Label Content="Телефон*"/>
                <TextBox x:Name="PhoneTextBox" Margin="0,0,0,10"/>

                <Label Content="Электронная почта"/>
                <TextBox x:Name="EmailTextBox" Margin="0,0,0,10"/>

                <!-- Юридическая информация -->
                <Label Content="Адрес"/>
                <TextBox x:Name="AddressTextBox" Margin="0,0,0,10" Height="60" 
                         TextWrapping="Wrap" AcceptsReturn="True"/>

                <Label Content="ИНН"/>
                <TextBox x:Name="InnTextBox" Text="0" Margin="0,0,0,10"/>

                <!-- Рейтинг и скидка -->
                <Label Content="Рейтинг (0-10)"/>
                <TextBox x:Name="RatingTextBox" Text="0" Margin="0,0,0,15"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Кнопка OK -->
        <Button Grid.Row="2" 
                Content="Создать" 
                Width="120" 
                HorizontalAlignment="Center"
                Padding="15,5"
                FontSize="14"
                Click="OkButton_Click"/>
    </Grid>
</Window>