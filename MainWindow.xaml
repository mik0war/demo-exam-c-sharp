<Window x:Class="demo_exam.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Управление партнёрами" Height="600" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <!-- Основное содержимое -->
            <RowDefinition Height="Auto"/>
            <!-- Кнопка внизу -->
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="PartnersList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="0,10" Margin="0,0,0,5" MouseLeftButtonUp="PartnerItem_MouseLeftButtonUp">
                            <Grid>
                                <StackPanel>
                                    <TextBlock FontWeight="Bold" FontSize="16">
                                        <Run Text="{Binding Type}"/>
                                        <Run Text=" | "/>
                                        <Run Text="{Binding Name}"/>
                                        <Run Text="    "/>
                                        <Run Text="{Binding Discount}" Foreground="Green"/>
                                        <Run Text="%"/>
                                    </TextBlock>

                                    <TextBlock Text="{Binding DirectorFullName}" 
                                               Margin="0,5,0,0" FontSize="14"/>

                                    <TextBlock Text="{Binding Phone}" 
                                               Margin="0,5,0,0" FontSize="14"/>

                                    <TextBlock Margin="0,5,0,0" FontSize="14">
                                        <Run Text="Рейтинг: "/>
                                        <Run Text="{Binding Rating}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Button Grid.Row="1" 
                Content="Создать партнёра" 
                HorizontalAlignment="Center" 
                Margin="0,10" 
                Padding="20,5"
                FontSize="16"
                Click="CreatePartner_Click"/>
    </Grid>
</Window>